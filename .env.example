# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database (Supabase PostgreSQL / Local PostgreSQL / SQLite for test)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vajranet
# Direct connection string if using Supabase connection pooler
DIRECT_URL=

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256

# Frontend URLs for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Cloudinary (Media Upload Signature)
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Assistant (Disaster Information Service)
AI_PROVIDER=mock
AI_API_KEY=mock-api-key
